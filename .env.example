# No values needed for the public fictional demo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Production fails closed without Supabase. Set true only for a fictional demo deployment.
PANTRYFIT_ALLOW_DEMO=false
# Enable only after configuring SMTP, a six-digit {{ .Token }} email template,
# short OTP expiry, and production abuse controls. See docs/LOGIN_SECURITY_HANDOFF.md.
PANTRYFIT_EMAIL_LOGIN_ENABLED=false
# Exact public HTTPS origin, without a trailing slash. Required for production login.
PANTRYFIT_APP_ORIGIN=
# Never add a service-role key to client code. This app uses user-scoped JWTs and RLS.
